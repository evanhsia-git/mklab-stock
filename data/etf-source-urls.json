      "現金流量表（NetCashProvidedByUsedInOperatingActivities 等）",
      "季報 10-Q、年報 10-K（申報清單與文件連結）"
    ],
    "endpoints": [
      {
        "url": "https://data.sec.gov/api/xbrl/companyfacts/CIK##########.json",
        "purpose": "一次取回該公司所有 XBRL 科目與各期間數字（營收、淨利、EPS、資產負債、現金流量）"
      },
      {
        "url": "https://data.sec.gov/api/xbrl/companyconcept/CIK##########/us-gaap/{tag}.json",
        "purpose": "單一科目（如 us-gaap/Revenues）的歷史序列"
      },
      {
        "url": "https://data.sec.gov/api/xbrl/frames/us-gaap/{tag}/USD/CY2024.json",
        "purpose": "跨公司同期比較（例：某一年所有公司的 Revenues）"
      },
      {
        "url": "https://data.sec.gov/submissions/CIK##########.json",
        "purpose": "申報清單（10-K／10-Q 的日期與文件連結）"
      },
      {
        "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK={cik}&type=10-K",
        "purpose": "人工查詢頁（browse-edgar）"
      }
    ],
    "cik_note": "CIK 為 10 碼零填充（例：Apple = 0000320193）；ETF／基金也有 CIK（例：Invesco QQQ Trust = 0001067839）。",
