  "sec_edgar": {
    "doc_url": "https://www.sec.gov/search-filings/edgar-application-programming-interfaces",
    "provides": [
      "公司營收（Revenues）",
      "淨利（NetIncomeLoss）",
      "EPS（EarningsPerShareBasic／Diluted）",
