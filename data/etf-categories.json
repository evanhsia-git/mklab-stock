{
  "meta": {
    "description": "ETF 分類規則（依使用者指定的類型代碼）。改規則不需改程式，由 skills/data/classify_etf.py 讀取。",
    "version": "2.0.0",
    "rule_priority": "代號結尾字母規則 > 明確代號清單 > 名稱關鍵字規則 > 預設類別。同一檔可同時屬於多類。",
    "note": "U 尾期貨型依使用者要求排除，不列入資料庫。K 尾（外幣+人民幣避險）不在使用者清單內，暫歸「待確認」。"
  },
  "excluded_suffix": ["U"],
  "suffix_rules": [
    { "suffix": "L", "category": "leveraged", "note": "代號結尾 L：槓桿型（如 00631L 元大台灣50正2）" },
    { "suffix": "R", "category": "inverse", "note": "代號結尾 R：反向型（如 00681R 元大美債20反1）" },
    { "suffix": "B", "category": "bond", "note": "代號結尾 B：債券型（如 00679B 元大美債20年）" },
    { "suffix": "C", "category": "bond_fx", "note": "代號結尾 C：債券外幣型（如 00687C 國泰20年美債+櫃U）" },
    { "suffix": "V", "category": "futures_fx", "note": "代號結尾 V：期貨外幣型（目前資料庫無此類）" },
    { "suffix": "T", "category": "balanced", "note": "代號結尾 T：平衡型（如 00981T 平衡凱基雙核收息）" },
    { "suffix": "A", "category": "active", "note": "代號結尾 A：主動式（如 00981A 主動統一台股增長）" },
    { "suffix": "D", "category": "active_bond", "note": "代號結尾 D：主動債券型（如 00982D 主動富邦動態入息）" },
    { "suffix": "K", "category": "unclassified", "note": "代號結尾 K：外幣+人民幣避險型，不在使用者類型清單內，待確認" }
  ],
  "explicit_codes": {
    "market_cap": ["0050", "006208", "009816", "00692", "00850", "0051", "00690", "00922", "00923"],
    "dividend_high": ["0056", "00878", "00919"]
  },
  "name_keywords": {
    "dividend_high": ["高息", "高股息", "高配息", "股利", "收益", "配息"],
    "theme": ["半導體", "AI", "人工智慧", "電動車", "生技", "金融", "電子", "5G", "綠能", "ESG", "車用", "航運", "鋼鐵", "電力", "基建"]
  },
  "category_labels": {
